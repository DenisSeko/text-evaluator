# OpenAI API key — NEVER commit the real key.
# Copy this file to `.env` (gitignored) and fill in the real value:
#   cp .env.example .env
OPENAI_API_KEY=sk-REPLACE_ME

# Model used by the 4 evaluation agents (cheap, fast, good JSON).
LEXI_MODEL=gpt-4.1-mini

# Model used by the synthesizer agent for the final verdict (higher quality, 1 call per run).
LEXI_MODEL_SYNTH=gpt-5-mini

# Max characters of article text sent to each agent (truncated).
LEXI_MAX_CHARS=40000

# Sampling temperature (low = consistent, deterministic-ish scoring).
LEXI_TEMPERATURE=0.3

# Scoring weights per agent — must sum to 1.0.
LEXI_WEIGHT_STRUCTURE=0.30
LEXI_WEIGHT_RUBRIC=0.30
LEXI_WEIGHT_PSYCHOLOGY=0.25
LEXI_WEIGHT_HUMANITY=0.15

# Cache directory for raw HTML (gitignored).
LEXI_CACHE_DIR=.cache

# HTTP timeout for scraping (seconds).
LEXI_REQUEST_TIMEOUT=60.0
